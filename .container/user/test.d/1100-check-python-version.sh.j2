#!/usr/bin/env bash
set -eo pipefail

ACTUAL=$(get-python-version)
EXPECTED=$(decomment < /deps/python/{{ ENV.B19_PYTHON_SERIES }}/version.deps)

if [ "${ACTUAL}" != "${EXPECTED}" ]
then
  echo "FATAL: expected ${EXPECTED}, got ${ACTUAL}" >&2
  exit 1
fi
